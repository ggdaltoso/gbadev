---
// Runs a snippet ROM in the page with mGBA (WebAssembly).
// The page must be cross-origin isolated: see public/_headers.
interface Props {
	/** Snippet folder name: snippets/<name>/<name>.gba */
	name: string;
}
const { name } = Astro.props;
---

<gba-rom data-name={name}>
	<div class="bezel">
		<span class="led"></span>
		<div class="screen">
			<canvas width="240" height="160"></canvas>
			<button type="button">▶&#xFE0E; Run {name}.gba</button>
		</div>
	</div>
	<p class="keys">Arrows: D-pad · X: A · Z: B · Enter: Start · Backspace: Select · A/S: L/R</p>
</gba-rom>

<style>
	gba-rom {
		display: block;
		max-width: 560px;
		margin-inline: auto;
		text-align: center;
	}
	/* A handheld-like frame: plain shapes, no logos. Starlight spaces sibling
	   elements in content, so margins are reset inside. */
	gba-rom * {
		margin: 0;
	}
	.bezel {
		position: relative;
		padding: 5% 9% 7%;
		border-radius: 0.5rem 0.5rem 1.75rem 1.75rem;
		background: #34343f;
		box-shadow:
			inset 0 -4px 0 rgb(0 0 0 / 0.25),
			0 6px 16px rgb(0 0 0 / 0.3);
	}
	.led {
		position: absolute;
		left: 3.5%;
		top: 45%;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #2a2a30;
	}
	gba-rom.on .led {
		background: #7be37b;
		box-shadow: 0 0 6px #7be37b;
	}
	.screen {
		position: relative;
		box-shadow: 0 0 0 2px #1d1d24;
	}
	canvas {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 2;
		background: #000;
		image-rendering: pixelated;
	}
	button {
		position: absolute;
		inset: 0;
		width: 100%;
		border: 0;
		background: transparent;
		color: #fff;
		font-size: 1.25rem;
		cursor: pointer;
	}
	.keys {
		margin-top: 0.75rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>

<script>
	// shortcut: mGBA is one stateful runtime, so only one ROM per page; split into instances if a page needs two.
	class GbaRom extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button')!;
			button.addEventListener('click', () => this.run(button), { once: true });
		}

		async run(button: HTMLButtonElement) {
			const name = this.dataset.name!;
			if (!crossOriginIsolated) {
				button.textContent = 'This page is not cross-origin isolated, so the emulator cannot start.';
				return;
			}
			button.textContent = 'Loading…';
			// Absolute URL: Vite dev leaves it alone instead of adding ?import to a public/ file.
			const mgbaUrl = new URL('/mgba/mgba.js', location.href).href;
			const { default: mGBA } = await import(/* @vite-ignore */ mgbaUrl);
			const emulator = await mGBA({ canvas: this.querySelector('canvas')! });
			await emulator.FSInit();

			const response = await fetch(`/roms/${name}.gba`);
			if (!response.ok) {
				button.textContent = `Could not load ${name}.gba (${response.status}).`;
				return;
			}
			const path = `${emulator.filePaths().gamePath}/${name}.gba`;
			emulator.FS.writeFile(path, new Uint8Array(await response.arrayBuffer()));
			emulator.loadGame(path);
			button.remove();
			this.classList.add('on');
		}
	}
	customElements.define('gba-rom', GbaRom);
</script>
